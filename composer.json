{
    "name": "dmlab/module-admin-scim-azure",
    "description": "Microsoft Entra ID provider plugin for the admin-scim SCIM 2.0 server — canonicalizes Entra's core-URN-qualified attributes and group-member removes, and documents the Entra enterprise-app provisioning setup. Installing it pulls dmlab/module-admin-scim.",
    "keywords": [
        "magento2",
        "magento2-module",
        "magento 2",
        "scim",
        "scim 2.0",
        "provisioning",
        "deprovisioning",
        "offboarding",
        "entra id",
        "microsoft entra",
        "azure ad",
        "admin users"
    ],
    "homepage": "https://github.com/dmlab-work/module-admin-scim-azure",
    "type": "magento2-module",
    "license": "OSL-3.0",
    "version": "0.2.2",
    "support": {
        "issues": "https://github.com/dmlab-work/module-admin-scim-azure/issues",
        "source": "https://github.com/dmlab-work/module-admin-scim-azure"
    },
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "magento/framework": "^103.0.7",
        "dmlab/module-admin-scim": "^0.2.0",
        "magento/module-backend": "^102.0.7",
        "magento/module-config": "^101.2.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5||^12.5"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "DmLab\\AdminScimAzure\\": ""
        }
    }
}
