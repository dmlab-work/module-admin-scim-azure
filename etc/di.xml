<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Di-merge the Entra normalizer into admin-scim's provider-quirk seam. -->
    <type name="MageDevGroup\AdminScim\Model\Normalization\RequestNormalizerChain">
        <arguments>
            <argument name="normalizers" xsi:type="array">
                <item name="azure" xsi:type="object">
                    MageDevGroup\AdminScimAzure\Model\Normalization\AzureRequestNormalizer
                </item>
            </argument>
        </arguments>
    </type>
</config>
